<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AssinaPDF</AssemblyName>
    <RootNamespace>FutureSolucoes.AssinaPDF</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../../public/favicon.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Product>AssinaPDF</Product>
    <Company>Future Soluções</Company>
    <Description>Leitor de PDF e assinatura digital PAdES.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="placement-viewer.html;placement-viewer.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../public/logo-future.png" Link="logo-future.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="viewer\\**\\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="SimpleSign.PAdES" Version="0.9.2" />
  </ItemGroup>
</Project>
