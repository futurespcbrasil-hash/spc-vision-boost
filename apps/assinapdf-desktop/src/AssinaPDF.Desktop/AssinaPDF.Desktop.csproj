    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AssinaPDF</AssemblyName>
    <RootNamespace>FutureSolucoes.AssinaPDF</RootNamespace>
