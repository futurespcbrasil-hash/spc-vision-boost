<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="AssinaPDF | Future Soluções"
    Manufacturer="Future Soluções"
    Version="0.4.0"
    UpgradeCode="9F6C6C20-3BA4-4F69-9B6C-60C8DAE3D114"
    Scope="perMachine"
    Language="1046">
    <SummaryInformation Description="AssinaPDF — leitor e assinatura digital de PDFs" />
    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais recente do AssinaPDF instalada." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AssinaPDFIcon" SourceFile="../../../public/favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AssinaPDFIcon" />

    <Feature Id="MainFeature" Title="AssinaPDF" Level="1">
      <ComponentGroupRef Id="PublishedAppFiles" />
      <ComponentRef Id="AssinaPDFExecutableComponent" />
      <ComponentRef Id="AssinaPDFStartMenuShortcut" />
      <ComponentRef Id="AssinaPDFDesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="FutureAppDirectory" Name="Future Soluções">
        <Directory Id="INSTALLFOLDER" Name="AssinaPDF" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AssinaPDF" />
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AssinaPDFExecutableComponent" Guid="D4B44A87-4E10-44E9-9E8F-55D6D68B5E21">
        <File Id="AssinaPDFExecutable" Source="$(AppExePath)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="AssinaPDFStartMenuShortcut" Guid="9AB87B67-AE27-44B4-9A26-A8A0E82BDE1B">
        <Shortcut Id="StartMenuShortcut" Name="AssinaPDF" Target="[#AssinaPDFExecutable]" WorkingDirectory="INSTALLFOLDER" Icon="AssinaPDFIcon" />
        <RegistryValue Root="HKCU" Key="Software\Future Soluções\AssinaPDF" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="AssinaPDFDesktopShortcut" Guid="7DA9D706-2A8A-4B6D-B7B8-7A64E52B21E2">
        <Shortcut Id="DesktopShortcut" Name="AssinaPDF" Target="[#AssinaPDFExecutable]" WorkingDirectory="INSTALLFOLDER" Icon="AssinaPDFIcon" />
        <RegistryValue Root="HKCU" Key="Software\Future Soluções\AssinaPDF" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="PublishedAppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" />
    </ComponentGroup>
  </Fragment>
</Wix>