<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="AssinaPDF | Future Soluções"
    Manufacturer="Future Soluções"
    Version="0.3.0"
    UpgradeCode="9F6C6C20-3BA4-4F69-9B6C-60C8DAE3D114"
    Scope="perUser"
    Language="1046">
    <SummaryInformation Description="AssinaPDF — leitor e assinatura digital de PDFs" />
    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais recente do AssinaPDF instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="AssinaPDF" Level="1">
      <ComponentGroupRef Id="PublishedAppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="FutureAppDirectory" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Future Soluções\AssinaPDF" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="PublishedAppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" Exclude="$(PublishDir)**\*.pdb;$(PublishDir)**\*.xml" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="7B1E8B1B-81F6-4DB2-8F18-7A1BA6D3F6E1">
      <Shortcut Id="AssinaPDFStartMenuShortcut"
                Name="AssinaPDF"
                Description="Leitura e assinatura digital de PDFs"
                Target="[INSTALLFOLDER]AssinaPDF.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAssinaPDFStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Future Soluções\AssinaPDF"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
