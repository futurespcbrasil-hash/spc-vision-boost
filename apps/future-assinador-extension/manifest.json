{
  "manifest_version": 3,
  "name": "Future Assinador Digital",
  "short_name": "Future Assinador",
  "description": "Ponte local autorizada para o Assinador Digital Future.",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": [
      "https://futuresolucoes.com.br/*",
      "https://www.futuresolucoes.com.br/*",
      "https://crm.futuresolucoes.com.br/*"
    ],
    "js": ["protocol.js", "content.js"],
    "run_at": "document_start"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
